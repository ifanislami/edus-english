# Public browser configuration for the EduEnglish project.
# Do not put service_role keys, database passwords, or other server secrets here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Temporary Google Sheets integration. Restrict this key to allowed APIs and domains.
VITE_GOOGLE_API_KEY=
VITE_SHEETS_ID=

# Server-only values for scripts/sync-content-from-sheets.mjs.
# Never expose SUPABASE_SERVICE_ROLE_KEY in a VITE_ variable or browser bundle.
GOOGLE_SHEET_ID=
GOOGLE_SHEETS_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
